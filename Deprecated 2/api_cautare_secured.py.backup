from fastapi import FastAPI, HTTPException, Depends, status
from fastapi.security import OAuth2PasswordBearer, OAuth2PasswordRequestForm
from jose import JWTError, jwt
from datetime import datetime, timedelta
from typing import Optional, List
from pydantic import BaseModel
import uvicorn
import os

from qdrant_client import QdrantClient
from sentence_transformers import SentenceTransformer

# Import RAG Engine
from rag_engine import RAGEngine

# Import configuration
import config

# --- FastAPI App Initialization ---
app = FastAPI(
    title="PDF Search API (Secured)",
    description="API pentru căutare semantică și RAG în documente PDF, cu control acces bazat pe roluri.",
    version="1.0.0"
)

# --- Security Configuration ---
SECRET_KEY = config.SECRET_KEY
ALGORITHM = config.ALGORITHM
ACCESS_TOKEN_EXPIRE_MINUTES = config.ACCESS_TOKEN_EXPIRE_MINUTES

oauth2_scheme = OAuth2PasswordBearer(tokenUrl="login")

# --- User Management (In-memory for demo) ---
USERS = config.USERS

def get_user_role(username: str):
    return USERS.get(username, {}).get("role")

def get_allowed_folders(username: str):
    return USERS.get(username, {}).get("allowed_folders", [])

# --- Qdrant and Embedding Model Initialization ---
qdrant_host = config.QDRANT_HOST
qdrant_port = config.QDRANT_PORT
collection_name = config.QDRANT_COLLECTION_NAME

client = QdrantClient(host=qdrant_host, port=qdrant_port)
model = SentenceTransformer(config.EMBEDDING_MODEL)

# --- RAG Engine Initialization ---
rag_engine = None
try:
    rag_engine = RAGEngine(
        model_name=config.LLM_MODEL,
        temperature=config.LLM_TEMPERATURE,
        max_tokens=config.LLM_MAX_TOKENS
    )
    print(f"RAG Engine initialized with model: {config.LLM_MODEL}")
except Exception as e:
    print(f"Warning: Could not initialize RAG Engine. Chat functionality will be disabled. Error: {e}")

# --- Helper Functions for Security ---
def create_access_token(data: dict, expires_delta: Optional[timedelta] = None):
    to_encode = data.copy()
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=15)
    to_encode.update({"exp": expire})
    encoded_jwt = jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)
    return encoded_jwt

async def verify_bearer_token(token: str = Depends(oauth2_scheme)):
    credentials_exception = HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Could not validate credentials",
        headers={"WWW-Authenticate": "Bearer"},
    )
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        username: str = payload.get("sub")
        if username is None:
            raise credentials_exception
        return username
    except JWTError:
        raise credentials_exception

# --- Data Models ---
class Token(BaseModel):
    access_token: str
    token_type: str
    username: str
    role: str

class SearchRequest(BaseModel):
    query: str
    limit: int = 10

class SearchResult(BaseModel):
    text: str
    score: float
    source: str
    page: int
    document_type: str

class ChatRequest(BaseModel):
    query: str
    limit: int = 5 # Number of context documents to retrieve

class ChatResponse(BaseModel):
    answer: str
    context_used: List[SearchResult]

# --- Access Control Logic ---
def filter_results_by_user(results: List[dict], username: str) -> List[dict]:
    """
    Filtrează rezultatele căutării bazat pe permisiunile utilizatorului.
    Un utilizator are acces la un document dacă folderul documentului
    este în lista de `allowed_folders` a utilizatorului.
    """
    user_allowed_folders = get_allowed_folders(username)
    
    if not user_allowed_folders: # Dacă nu are foldere specificate, nu are acces la nimic
        return []

    filtered = []
    for hit in results:
        doc_folder = hit["payload"].get("folder")
        if doc_folder and doc_folder in user_allowed_folders:
            filtered.append(hit)
    return filtered

# --- API Endpoints ---
@app.post("/login", response_model=Token)
async def login_for_access_token(form_data: OAuth2PasswordRequestForm = Depends()):
    user = USERS.get(form_data.username)
    if not user or user["password"] != form_data.password:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Incorrect username or password",
            headers={"WWW-Authenticate": "Bearer"},
        )
    
    role = user["role"]
    access_token_expires = timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)
    access_token = create_access_token(
        data={"sub": form_data.username, "role": role}, expires_delta=access_token_expires
    )
    return Token(
        access_token=access_token,
        token_type="bearer",
        username=form_data.username,
        role=role
    )


@app.get("/me")
async def get_current_user(username: str = Depends(verify_bearer_token)):
    """Returnează informații despre utilizatorul curent"""
    role = get_user_role(username)
    allowed_folders = get_allowed_folders(username)
    
    return {
        "username": username,
        "role": role,
        "name": USERS[username]["name"],
        "allowed_folders": allowed_folders
    }


