# ============================================================================
# PyPro Search & Chat - Exemplu Configurare Variabile de Mediu
# ============================================================================
# 
# Copiază acest fișier ca ".env" și modifică valorile după nevoie.
# Fișierul .env nu va fi inclus în Git (este în .gitignore).
#
# Pentru a folosi variabilele de mediu pe Windows:
#   set COLLECTION_NAME=valoare
#
# Pentru Linux/Mac:
#   export COLLECTION_NAME=valoare
#
# ============================================================================

# Paths
QDRANT_PATH=qdrant_db
INDEXING_FOLDER=\\192.168.27.44\ERP-implementare\Specificatii de lucru

# Qdrant Database
COLLECTION_NAME=documente_pdf
BATCH_SIZE=50
QDRANT_TIMEOUT=10

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# Whisper (Video Processing)
WHISPER_MODEL_SIZE=large
VIDEO_BLOCK_DURATION=60
WHISPER_BEAM_SIZE=5

# Document Processing
DOCX_PARAGRAPHS_PER_PAGE=10

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
MAX_SEARCH_RESULTS=100
DEFAULT_SEARCH_LIMIT=10

# RAG (Chat AI)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
RAG_CONTEXT_LIMIT=5

# Logging
LOG_LEVEL=INFO

# Performance
NUM_WORKERS=0

# Security (SCHIMBĂ ÎN PRODUCȚIE!)
SECRET_KEY=schimba-aceasta-cheie-in-productie-cu-ceva-foarte-secret
TOKEN_EXPIRE_HOURS=24
